# Copy to .env and fill in the values. Never commit .env.
# LEDGERLENS_OFFLINE=1 runs everything with no keys and no network (scripted model, local embeddings, recorded responses).
LEDGERLENS_OFFLINE=

# Chat model for online mode, as "<provider>:<model name>" for init_chat_model. The tools agent expects an OpenAI-style tool-calling model.
OPENAI_API_KEY=
LEDGERLENS_MODEL=

# The cascade of the deployment, from the lightest model to the most capable one, separated by commas. The router
# takes for each task of a run the lightest model of the cascade that fits it (ADR-078).
LEDGERLENS_MODEL_CASCADE=

# The consent of the deployment about the retries of a task (ADR-084). The number of retries a failed task may get,
# and the direction of the cascade they go: "up" asks for a more capable model, "down" for a lighter one. The
# default is no retry at all, and a retry always needs the remaining budget of the run to cover it.
LEDGERLENS_FALLBACK_ATTEMPTS=
LEDGERLENS_FALLBACK_DIRECTION=

# Online defaults to "openai". Set "fastembed" explicitly to use a local model. Offline uses word counts.
LEDGERLENS_EMBEDDINGS=

# LangSmith tracing and evaluation (online only).
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# Optional: URL of a running internal ledger service. Leave empty to call it in process.
# LEDGERLENS_LEDGER_API_URL=

# Life of a sandbox branch: seconds of idleness and seconds in absolute terms.
LEDGERLENS_SANDBOX_BRANCH_IDLE_TTL_SECONDS=
LEDGERLENS_SANDBOX_BRANCH_ABSOLUTE_TTL_SECONDS=

# Database of the sandbox store. The url points at the container of docker-compose.yml:
# postgresql://ledgerlens@127.0.0.1:5433/ledgerlens_sandbox
# Empty means the file backed store, which is the one the fast unit tests use.
LEDGERLENS_SANDBOX_DATABASE_URL=

# Limits of the facade of the sandbox (ADR-047).
# The cap of live branches one session may hold. A fork of a scenario the session already holds is a reuse and is never
# refused by this cap, because no branch is created.
LEDGERLENS_SANDBOX_SESSION_BRANCH_CAP=
# The requests of one session in the window, and the length of the window in seconds. The counter lives in the memory of
# the process, so a deployment with N workers allows N times this quota.
LEDGERLENS_SANDBOX_RATE_LIMIT_REQUESTS=
LEDGERLENS_SANDBOX_RATE_LIMIT_WINDOW_SECONDS=

# Limits of the resources of one branch (FR-025). The mutations a branch may commit are counted over the mutations that
# were committed, and an undone mutation stays counted. The events of a branch are counted against the log of the branch,
# and the marker of an undo is one of those events.
LEDGERLENS_SANDBOX_MAX_COMMITTED_MUTATIONS=
LEDGERLENS_SANDBOX_MAX_EVENTS=

# Origins of the browser that may call the API of the demo, separated by commas. The site of the demo is a static
# export and the live mode lives on another origin, so the backend has to say which origins may call it (ADR-040).
# Empty means no origin may call it with the cookie of the session, which is the default of a backend that serves
# nothing but its own tests.
LEDGERLENS_CORS_ORIGINS=
