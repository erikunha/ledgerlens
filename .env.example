# Copy to .env and fill in the values. Never commit .env.
# LEDGERLENS_OFFLINE=1 runs everything with no keys and no network (scripted model, local embeddings, recorded responses).
LEDGERLENS_OFFLINE=

# Chat model for online mode, as "<provider>:<model name>" for init_chat_model. The tools agent expects an OpenAI-style tool-calling model.
OPENAI_API_KEY=
LEDGERLENS_MODEL=

# "fastembed" (local, offline) or "openai". The index must be built with the same value.
LEDGERLENS_EMBEDDINGS=

# LangSmith tracing and evaluation (online only).
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# Optional: URL of a running internal ledger service. Leave empty to call it in process.
# LEDGERLENS_LEDGER_API_URL=

# Life of a sandbox branch: seconds of idleness and seconds in absolute terms.
LEDGERLENS_SANDBOX_BRANCH_IDLE_TTL_SECONDS=
LEDGERLENS_SANDBOX_BRANCH_ABSOLUTE_TTL_SECONDS=
