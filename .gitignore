# secrets
.env
.env.*
!.env.example
# environment
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# data generated at run time
data/runtime/
# downloaded public files (their own license; the checksum lives in data/sources.lock.json)
data/raw/
# database generated by ledgerlens-sim; rebuilt from data/sample with the same hash
data/ledger.db

.plans/
# the specification toolkit and the specs it writes are part of the work and do stay in.
# the negations come after, because a broader ignore rule higher up would otherwise win.
!/.specify/
!/.specify/**
!/specs/
!/specs/**
!/docs/v3/specs/
!/docs/v3/specs/**
