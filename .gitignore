# secrets
.env
.env.*
!.env.example
# environment
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# data generated at run time
data/runtime/
# the answer key of the generator of the held out set: it is not published, because it is the key of a set whose
# whole purpose is to be untuned. The generator is public and deterministic, so anybody can rebuild it with
# `uv run python -m ledgerlens.eval.heldout`, and the blindness of the reading was a procedure and not a secret
data/eval/heldout/recipes.jsonl
# downloaded public files (their own license; the checksum lives in data/sources.lock.json)
data/raw/
# database generated by ledgerlens-sim; rebuilt from data/sample with the same hash
data/ledger.db

.plans/
# the handoff of the cycle is local material: it names the paths of the machine of the author, so it is
# never committed and never staged
docs/handoff-v3.md
# the index of the editor is the state of one machine and it is rebuilt at run time, so it stays out of git
.serena/
# the specification toolkit and the specs it writes are part of the work and do stay in.
# the negations come after, because a broader ignore rule higher up would otherwise win.
!/.specify/
!/.specify/**
!/specs/
!/specs/**
!/docs/v3/specs/
!/docs/v3/specs/**
