{
  "name": "@ledgerlens/web",
  "version": "0.1.0",
  "private": true,
  "description": "Public site of LedgerLens: the recorded replay of a payment investigation, exported as static files.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/sync-replay-artifacts.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-replay-artifacts.mjs",
    "build": "next build",
    "export": "next build",
    "preview": "serve out",
    "start": "serve out",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/sync-replay-artifacts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gate": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "next": "15.5.29",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "15.5.29",
    "@playwright/test": "1.55.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "24.19.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.32",
    "prettier": "3.10.0",
    "serve": "14.2.7",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "3.2.7"
  }
}
