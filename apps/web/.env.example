# Copy to .env.local and fill in the values. Never commit .env.local.
#
# The origin of the API of the demo, the one the browser calls with the cookie of the session. The default is the
# port of the console script `ledgerlens-demo`, which is the wired application of the repository (ADR-039).
#
# The origin has to be the SAME SITE as the origin of this site, because the cookie of the session is SameSite=Lax
# and a cookie of Lax does not travel to another site (ADR-040).
NEXT_PUBLIC_LEDGERLENS_API_BASE_URL=http://localhost:8010
