{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ledgerlens/spec/live-run-request.schema.json",
  "$comment": "Design contract, not deployed implementation.",
  "title": "RunRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "scenario_id",
    "sandbox_id",
    "expected_revision",
    "account_id",
    "question",
    "variant",
    "limits"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "live_agent",
        "deterministic_sandbox"
      ]
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^S[0-9]{2}$"
    },
    "sandbox_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "account_id": {
      "type": "string",
      "pattern": "^(?:C-[0-9]{4}|M-[0-9]{2})$"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "variant": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "model_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "credential_handle": {
      "type": "string",
      "minLength": 1
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_model_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 180
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 128,
          "maximum": 16000
        }
      },
      "required": [
        "max_model_calls",
        "max_tool_calls",
        "max_wall_seconds",
        "max_output_tokens"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "live_agent"
          }
        }
      },
      "then": {
        "required": [
          "model_profile_id",
          "credential_handle"
        ]
      }
    }
  ]
}
