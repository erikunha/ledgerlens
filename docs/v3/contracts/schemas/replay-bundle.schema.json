{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ledgerlens/spec/replay-bundle.schema.json",
  "$comment": "Design contract, not deployed implementation.",
  "title": "RecordedReplayBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "replay_id",
    "capture_kind",
    "recorded_at",
    "scenario_id",
    "snapshot_sha256",
    "code_sha",
    "model_profile",
    "run_result",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "replay_id": {
      "type": "string",
      "minLength": 1
    },
    "capture_kind": {
      "type": "string",
      "enum": [
        "real_model_recorded",
        "scripted_fixture"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^S[0-9]{2}$"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "code_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "model_profile": {
      "type": "string",
      "minLength": 1
    },
    "prompt_hash": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "redaction_version": {
      "type": "string"
    },
    "run_result": {
      "$ref": "https://example.invalid/ledgerlens/spec/public-investigation-result.schema.json"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "https://example.invalid/ledgerlens/spec/trace-event.schema.json"
      }
    }
  }
}
