{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ledgerlens:v3:decision-record",
  "title": "LedgerLens v3 decision-record",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "lens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "experiment": {
      "type": "string",
      "minLength": 1
    },
    "reversal_cost": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "running",
        "validated",
        "rejected",
        "parked"
      ]
    },
    "what_changes_mind": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "hypothesis",
    "lens",
    "options",
    "experiment",
    "reversal_cost",
    "evidence_refs",
    "status",
    "what_changes_mind",
    "result"
  ],
  "additionalProperties": false
}
