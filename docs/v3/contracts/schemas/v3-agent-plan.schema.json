{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ledgerlens:v3:agent-plan",
  "title": "LedgerLens v3 agent-plan",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "branch_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "account_scope": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "allowed_tools": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "max_calls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12
          }
        },
        "required": [
          "step_id",
          "role",
          "dependencies",
          "allowed_tools",
          "max_calls"
        ],
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "model_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "max_usd": {
          "type": "string",
          "pattern": "^-?\\d+(?:\\.\\d{1,10})?$",
          "description": "Exact Decimal encoded as a string, not JSON floating-point money"
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "required": [
        "model_calls",
        "tool_calls",
        "max_usd",
        "deadline_ms",
        "max_parallel"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "validated",
        "running",
        "waiting_human",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "review_required": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "branch_id",
    "snapshot_hash",
    "account_scope",
    "steps",
    "budget",
    "status",
    "review_required"
  ],
  "additionalProperties": false
}
