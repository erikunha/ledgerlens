{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ledgerlens/spec/trace-event.schema.json",
  "$comment": "Design contract, not deployed implementation.",
  "title": "TraceEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "seq",
    "at",
    "event_type",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "run.started",
        "plan.created",
        "span.started",
        "span.ended",
        "evidence.added",
        "claim.verdict",
        "run.status",
        "run.completed",
        "run.failed",
        "run.cancelled",
        "heartbeat"
      ]
    },
    "span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "recorded_replay",
        "deterministic_sandbox",
        "live_agent"
      ]
    }
  }
}
