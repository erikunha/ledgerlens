{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ledgerlens:v3:experiment-manifest",
  "title": "LedgerLens v3 experiment-manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "seed": {
      "type": "integer"
    },
    "mode": {
      "type": "string",
      "enum": [
        "recorded_replay",
        "deterministic_sandbox",
        "live_provider"
      ]
    },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "correctness_method": {
      "type": "string",
      "minLength": 1
    },
    "model_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sample_size": {
      "type": "integer",
      "minimum": 1
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "complete": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "experiment_id",
    "source_commit",
    "dataset_sha256",
    "evaluation_sha256",
    "seed",
    "mode",
    "architectures",
    "case_ids",
    "run_ids",
    "correctness_method",
    "model_versions",
    "sample_size",
    "limitations",
    "complete"
  ],
  "additionalProperties": false
}
