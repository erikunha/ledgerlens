{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ledgerlens:v3:portfolio-proof",
  "title": "LedgerLens v3 portfolio-proof",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "recorded_replay",
        "deterministic_sandbox",
        "live_provider"
      ]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trace_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdict_summary": {
      "type": "string"
    },
    "cost_usd": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^-?\\d+(?:\\.\\d{1,10})?$",
          "description": "Exact Decimal encoded as a string, not JSON floating-point money"
        },
        {
          "type": "null"
        }
      ]
    },
    "cost_provenance": {
      "type": "string",
      "enum": [
        "observed",
        "computed_from_observed",
        "simulated",
        "assumed",
        "replayed",
        "estimated",
        "unknown"
      ]
    },
    "known_limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "privacy_reviewed": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "mode",
    "source_commit",
    "scenario_id",
    "snapshot_hash",
    "trace_refs",
    "claim_evidence_refs",
    "verdict_summary",
    "cost_usd",
    "cost_provenance",
    "known_limitations",
    "privacy_reviewed"
  ],
  "additionalProperties": false
}
